# -----------------------------------------------------------------------------
# LacS·GOS Console — environment variables
#
# Local:  copy this file to .env.local and fill in the values.
# Vercel: Project → Settings → Environment Variables (same three names).
# Values: Supabase dashboard → Project Settings → API (or "API Keys").
#
# Without these the app cannot authenticate, so every page redirects to /login.
# -----------------------------------------------------------------------------

# Public — sent to the browser. Safe because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Bypasses RLS; used only to read the hidden grid table
# and by `npm run create-user`. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
